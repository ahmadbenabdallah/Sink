{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sink",
  "main": ".output/server/index.mjs",
  "assets": {
    "binding": "ASSETS",
    "directory": ".output/public",
    "html_handling": "drop-trailing-slash"
  },
  "compatibility_date": "2025-05-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "keep_vars": true,
  // Production is served from the custom domain attached in the Cloudflare dashboard.
  // Set explicitly so deploys do not enable the workers.dev address or preview URLs by default.
  "workers_dev": false,
  "preview_urls": false,
  "upload_source_maps": true,
  "observability": {
    "logs": {
      "enabled": true
    },
    "traces": {
      "enabled": true
    }
  },
  "ai": {
    "binding": "AI",
    "remote": true
  },
  // CLI deploy (pnpm deploy:worker / deploy:config) rewrites them into gitignored wrangler.deploy.jsonc.
  // Prefer setting DEPLOY_* in .env or Workers Builds / Pages variables — do not hardcode
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "sink" // Override with DEPLOY_ANALYTICS_DATASET (default: sink). Keep in sync with NUXT_DATASET at runtime.
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "preview_id": "ef93d42dc4b34969bab404d2e80f8dd3", // Override with DEPLOY_KV_PREVIEW_NAMESPACE_ID (falls back to DEPLOY_KV_NAMESPACE_ID)
      "id": "ef93d42dc4b34969bab404d2e80f8dd3" // Override with DEPLOY_KV_NAMESPACE_ID
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sink", // Override with DEPLOY_D1_DATABASE_NAME (default: sink)
      "database_id": "ef964055-65bf-4b78-b109-ac9c9290ae62", // Override with DEPLOY_D1_DATABASE_ID (required for CLI deploy)
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      // preview_bucket_name: DEPLOY_R2_PREVIEW_BUCKET_NAME (falls back to DEPLOY_R2_BUCKET_NAME)
      // omit DEPLOY_R2_BUCKET_NAME to drop R2 from generated deploy config
      "preview_bucket_name": "sink",
      "bucket_name": "sink" // Override with DEPLOY_R2_BUCKET_NAME
    }
  ],
  // namespace_id is any positive integer unique within the account; period must be 10 or 60.
  "ratelimits": [
    // Link-password guesses per slug and client IP (server/utils/link-password-limit.ts).
    {
      "name": "LINK_PASSWORD_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    // Requests to /api/ per client IP, counted before the token check (server/middleware/2.auth.ts).
    // 1200 leaves room for the dashboard plus an MCP agent on the same address: a session
    // stays under about 100 a minute, and an agent calling tools back to back reaches 300 to 600.
    {
      "name": "API_AUTH_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 1200,
        "period": 60
      }
    }
  ],
  "triggers": {
    "crons": ["0 0 * * *"] // Run backup task daily at 00:00 UTC
  }
}
